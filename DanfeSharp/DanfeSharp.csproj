<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>DanfeSharp</RootNamespace>
    <AssemblyName>DanfeSharp</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppDesignerFolder>Properties</AppDesignerFolder>

    <!-- Mantém a saída em bin\Debug\ (sem subpasta net48\), pois DanfeSharp.Test referencia
         PDFClown.dll diretamente a partir de ..\DanfeSharp\bin\Debug\. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFClown" Version="0.1.2" />
  </ItemGroup>

  <!-- Arquivo órfão pré-existente: nunca esteve no <Compile Include> do .csproj original (formato
       clássico, sem glob automático), então nunca foi compilado. Contém uma classe DuplicataViewModel
       duplicada (e no namespace errado) da que já existe em Modelo\DuplicataViewModel.cs. Excluído aqui
       para preservar exatamente o comportamento de build anterior à migração para o formato SDK-style. -->
  <ItemGroup>
    <Compile Remove="Modelo\FaturaViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
